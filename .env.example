# API Keys and Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Google API (for Sheets, Slides, etc.)
# GOOGLE_API_KEY=

# FireCrawl (web scraping/crawling MCP server)
# FIRECRAWL_API_KEY=

# API-Football — for H2H stats, match history, corners, cards
# RECOMMENDED: Subscribe directly at https://www.api-football.com (more reliable)
#   Pro plan = $19/mo, 7500 req/day — enough for 10-20 analyses/day
#   After subscribing, your key is at: https://dashboard.api-football.com/profile
# ALTERNATIVE: Via RapidAPI at https://rapidapi.com/api-sports/api/api-football
#   If using RapidAPI, also set API_FOOTBALL_VIA_RAPIDAPI=true below
# API_FOOTBALL_KEY=
# API_FOOTBALL_VIA_RAPIDAPI=false

# Add other API keys as needed for your workflows
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
